{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["es2023", "dom"],
    "paths": { "svg-diagram": ["./lib/dsl.ts"] }
  },
  "include": ["*.ts", "lib/**/*.ts", "test/**/*.ts", "examples/**/*.ts"]
}
