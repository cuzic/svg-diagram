{
  "name": "svg-diagram",
  "version": "0.5.0",
  "type": "module",
  "description": "Declarative SVG diagram DSL for documents: boxes, flows, swimlanes, sequences, tables, UI wireframes and screen-transition diagrams — with layout, overlap/contrast verification, lint and rule checks.",
  "bin": {
    "svg-diagram": "./bin/svg-diagram"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "harfbuzzjs": "^1.6.3",
    "sixel": "^0.16.0"
  },
  "peerDependencies": {
    "playwright-chromium": "^1.62.1",
    "mathjax-full": "^3.2.2"
  },
  "peerDependenciesMeta": {
    "playwright-chromium": {
      "optional": true
    },
    "mathjax-full": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "validate:pptx": "node test/helpers/pptx/validate.ts examples/*.ts",
    "golden:pptx": "node test/helpers/pptx/golden.ts examples/*.ts",
    "golden": "node --import ./test/helpers/strict-width.ts check-diagram.ts --drift --rebuild --svg-dir examples/out examples/*.ts",
    "typecheck": "tsc -p .",
    "build": "tsc -p tsconfig.build.json && pnpm run build:assets",
    "build:assets": "mkdir -p dist/lib/deck-viewer dist/lib/pptx/template && cp lib/deck-viewer/*.js lib/deck-viewer/*.css dist/lib/deck-viewer/ && cp -R lib/pptx/template/. dist/lib/pptx/template/",
    "release": "bash scripts/release.sh",
    "prepack": "rm -rf dist && tsc -p tsconfig.build.json && pnpm run build:assets"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuzic/svg-diagram.git"
  },
  "bugs": {
    "url": "https://github.com/cuzic/svg-diagram/issues"
  },
  "homepage": "https://github.com/cuzic/svg-diagram#readme",
  "keywords": [
    "svg",
    "diagram",
    "wireframe",
    "dsl",
    "documentation"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "markdown-it": "^14.3.2",
    "mathjax-full": "^3.2.2",
    "playwright-chromium": "1.62.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vitepress": "^1.6.4"
  },
  "types": "./dist/lib/dsl.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/dsl.d.ts",
      "default": "./dist/lib/dsl.js"
    },
    "./markdown-it": {
      "types": "./dist/lib/markdown-it.d.ts",
      "default": "./dist/lib/markdown-it.js"
    },
    "./remark": {
      "types": "./dist/lib/remark.d.ts",
      "default": "./dist/lib/remark.js"
    },
    "./vitepress": {
      "types": "./dist/lib/vitepress.d.ts",
      "default": "./dist/lib/vitepress.js"
    },
    "./markdown": {
      "types": "./dist/lib/markdown.d.ts",
      "default": "./dist/lib/markdown.js"
    },
    "./render": {
      "types": "./dist/lib/render-source.d.ts",
      "default": "./dist/lib/render-source.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
