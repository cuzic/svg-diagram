{
  "name": "svg-diagram",
  "version": "0.5.0",
  "type": "module",
  "description": "Declarative SVG diagram DSL for documents: boxes, flows, swimlanes, sequences, tables, UI wireframes and screen-transition diagrams — with layout, overlap/contrast verification, lint and rule checks.",
  "bin": {
    "svg-diagram": "./bin/svg-diagram"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "harfbuzzjs": "^1.6.3",
    "sixel": "^0.16.0"
  },
  "peerDependencies": {
    "mathjax-full": "^3.2.2",
    "playwright-chromium": "^1.62.1"
  },
  "peerDependenciesMeta": {
    "playwright-chromium": {
      "optional": true
    },
    "mathjax-full": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "validate:pptx": "node test/helpers/pptx/validate.ts examples/*.ts",
    "golden:pptx": "node test/helpers/pptx/golden.ts examples/*.ts",
    "golden": "node --import ./test/helpers/strict-width.ts check-diagram.ts --drift --rebuild --svg-dir examples/out examples/*.ts",
    "schema": "node scripts/schema.ts",
    "bundle-size": "node scripts/bundle-size.ts",
    "typecheck": "tsc -p .",
    "lint": "biome lint .",
    "build": "tsc -p tsconfig.build.json && pnpm run build:assets",
    "build:assets": "mkdir -p dist/lib/deck-viewer && cp lib/deck-viewer/*.js lib/deck-viewer/*.css dist/lib/deck-viewer/",
    "release": "bash scripts/release.sh",
    "prepack": "rm -rf dist && tsc -p tsconfig.build.json && pnpm run build:assets"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuzic/svg-diagram.git"
  },
  "bugs": {
    "url": "https://github.com/cuzic/svg-diagram/issues"
  },
  "homepage": "https://github.com/cuzic/svg-diagram#readme",
  "keywords": [
    "svg",
    "diagram",
    "wireframe",
    "dsl",
    "documentation"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "ajv": "8.20.0",
    "esbuild": "0.21.5",
    "jsqr": "1.4.0",
    "markdown-it": "^14.3.2",
    "mathjax-full": "^3.2.2",
    "playwright-chromium": "1.62.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vitepress": "^1.6.4"
  },
  "sideEffects": [
    "./dist/build-diagram.js",
    "./dist/check-diagram.js",
    "./dist/contact-sheet.js",
    "./dist/deck-diagram.js",
    "./dist/diff-svg.js",
    "./dist/init-project.js",
    "./dist/lib/bowtie.js",
    "./dist/lib/comic/constants.js",
    "./dist/lib/comic/slot-values.js",
    "./dist/lib/compose/canvas.js",
    "./dist/lib/deck-spec.js",
    "./dist/lib/deck-viewer/viewer.js",
    "./dist/lib/dsl/charts-stats.js",
    "./dist/lib/dsl/figures.js",
    "./dist/lib/dsl/wireframe-numbering.js",
    "./dist/lib/export-and-check.js",
    "./dist/lib/fit-width.js",
    "./dist/lib/font-metrics.js",
    "./dist/lib/icons.js",
    "./dist/lib/layout-connect.js",
    "./dist/lib/layout-handlers.js",
    "./dist/lib/layout-measure.js",
    "./dist/lib/layout.js",
    "./dist/lib/markdown-it.js",
    "./dist/lib/parts.js",
    "./dist/lib/pipeline.js",
    "./dist/lib/pptx/zip.js",
    "./dist/lib/present/qr.js",
    "./dist/lib/present/render-thread.js",
    "./dist/lib/present/ui.js",
    "./dist/lib/quadrant.js",
    "./dist/lib/render-sync-worker.js",
    "./dist/lib/resolve-hook.js",
    "./dist/lib/reveal-handlers.js",
    "./dist/lib/schema-files.js",
    "./dist/lib/slide-budget.js",
    "./dist/lib/slide-index.js",
    "./dist/lib/source-location-io.js",
    "./dist/lib/spec-kit.js",
    "./dist/lib/spec-parts/board.js",
    "./dist/lib/spec-parts/r1.js",
    "./dist/lib/spec-parts/r2.js",
    "./dist/lib/spec-parts/r3.js",
    "./dist/lib/spec-parts/r4.js",
    "./dist/lib/spec-parts/r5.js",
    "./dist/lib/spec-parts/r6.js",
    "./dist/lib/spec-parts/r7.js",
    "./dist/lib/spec.js",
    "./dist/lib/svg-outline.js",
    "./dist/lib/tokens.js",
    "./dist/lib/web.js",
    "./dist/lib/wireframe.js",
    "./dist/lib/wordart-vertical.js",
    "./dist/lib/wordart.js",
    "./dist/lib/wrap.js",
    "./dist/lint-svg.js",
    "./dist/manage-icons.js",
    "./dist/markdown-diagram.js",
    "./dist/notes-diagram.js",
    "./dist/pptx-deck-diagram.js",
    "./dist/pptx-diagram.js",
    "./dist/preview-svg.js",
    "./dist/serve-diagram.js",
    "./dist/show-diagram.js",
    "./dist/site-diagram.js",
    "./dist/typecheck.js"
  ],
  "types": "./dist/lib/dsl.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/dsl.d.ts",
      "default": "./dist/lib/dsl.js"
    },
    "./browser": {
      "types": "./dist/lib/web.d.ts",
      "default": "./dist/lib/web.js"
    },
    "./core": {
      "types": "./dist/lib/core.d.ts",
      "default": "./dist/lib/core.js"
    },
    "./bands/spacer": {
      "types": "./dist/lib/bands/spacer.d.ts",
      "default": "./dist/lib/bands/spacer.js"
    },
    "./bands/caption": {
      "types": "./dist/lib/bands/caption.d.ts",
      "default": "./dist/lib/bands/caption.js"
    },
    "./bands/connect": {
      "types": "./dist/lib/bands/connect.d.ts",
      "default": "./dist/lib/bands/connect.js"
    },
    "./bands/grid": {
      "types": "./dist/lib/bands/grid.d.ts",
      "default": "./dist/lib/bands/grid.js"
    },
    "./bands/row": {
      "types": "./dist/lib/bands/row.d.ts",
      "default": "./dist/lib/bands/row.js"
    },
    "./bands/box": {
      "types": "./dist/lib/bands/box.d.ts",
      "default": "./dist/lib/bands/box.js"
    },
    "./bands/gantt": {
      "types": "./dist/lib/bands/gantt.d.ts",
      "default": "./dist/lib/bands/gantt.js"
    },
    "./measure/browser": {
      "types": "./dist/lib/web-measure.d.ts",
      "default": "./dist/lib/web-measure.js"
    },
    "./html": {
      "types": "./dist/lib/emit-html.d.ts",
      "default": "./dist/lib/emit-html.js"
    },
    "./plugin": {
      "types": "./dist/lib/plugin.d.ts",
      "default": "./dist/lib/plugin.js"
    },
    "./markdown-it": {
      "types": "./dist/lib/markdown-it.d.ts",
      "default": "./dist/lib/markdown-it.js"
    },
    "./remark": {
      "types": "./dist/lib/remark.d.ts",
      "default": "./dist/lib/remark.js"
    },
    "./vitepress": {
      "types": "./dist/lib/vitepress.d.ts",
      "default": "./dist/lib/vitepress.js"
    },
    "./markdown": {
      "types": "./dist/lib/markdown.d.ts",
      "default": "./dist/lib/markdown.js"
    },
    "./render": {
      "types": "./dist/lib/render-source.d.ts",
      "default": "./dist/lib/render-source.js"
    },
    "./spec": {
      "types": "./dist/lib/spec.d.ts",
      "default": "./dist/lib/spec.js"
    },
    "./spec/edge": {
      "types": "./dist/lib/spec-edge.d.ts",
      "default": "./dist/lib/spec-edge.js"
    },
    "./pptx/edge": {
      "types": "./dist/lib/pptx-edge.d.ts",
      "default": "./dist/lib/pptx-edge.js"
    },
    "./pptx/deck/edge": {
      "types": "./dist/lib/pptx-deck-edge.d.ts",
      "default": "./dist/lib/pptx-deck-edge.js"
    },
    "./schema/*.json": "./schema/*.json"
  },
  "files": [
    "bin",
    "dist",
    "schema",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.2.2"
}
