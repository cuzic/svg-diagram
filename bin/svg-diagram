#!/usr/bin/env bash
# svg-diagram build <source.ts>... [--out file.svg | --out-dir DIR] [--stale] [--no-lint] [--html] [--id-prefix <p|auto>]   (default out: ./svg/<name>.svg, or "outDir" of .svg-diagram.json)
# svg-diagram check [--strict] [--typecheck] [--verbose] [--drift [--svg-dir DIR] [--rebuild [--jobs N] [--no-cache] [--cache-dir DIR]]] <source.ts>...
# svg-diagram init [dir]                                 (package.json + tsconfig.json for a diagram project)
# svg-diagram icons add|remove|list|search|notice ...   (the project's own icons: svg-diagram.icons.json; add mdi:key-variant=key)
# svg-diagram typecheck                                  (the project's tsc over its tsconfig.json)
# svg-diagram md <page.md> [--out FILE] [--svg-dir DIR] [--inline | --html] [--root DIR]   (draw the diagrams a Markdown page points at: ![alt](flow.diagram.ts))
# svg-diagram notes <source.ts>                         (the figure's numbered notes as a Markdown list)
# svg-diagram diff old.svg new.svg                       (what changed, in words)
# svg-diagram diff --text old.svg new.svg [--no-added] [--strict]   (which words/numbers of old.svg are gone from new.svg)
# svg-diagram contact a.svg b.svg ... --out sheet.png [--cols N] [--width PX] [--per-page N | --pages N]   (a whole set on one picture)
# svg-diagram deck <a.ts|a.svg>... [--out deck.html] [--title TEXT] [--cols N] [--csp]   (several figures in one self-contained HTML to look through: arrows, overview, zoom, print)
# svg-diagram pptx <source.ts>... [--out FILE | --out-dir DIR] [--png-scale N] [--font NAME]   (one editable PowerPoint file per source)
# svg-diagram lint  [file.svg|file.ts|glob ...] [--svg-dir DIR] [--strict] [--fix] [--engine geometry|browser]   (default: ./svg/*.svg; geometry needs no browser)
# svg-diagram show <file.svg|file.ts>... [--png FILE] [--scale N] [--width PX] [--engine resvg|chromium] [--require-fresh]   (draw it in the terminal as sixel)
# svg-diagram preview <in.svg> [out.png] [scale] [--engine resvg|chromium] [--gray] [--no-stale-banner] [--require-fresh]   (warns when the SVG is older than its source)
# Diagram sources import the DSL as:  import {diagram, box, ...} from 'svg-diagram'
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# Compiled dist/ when present (installed from a package); otherwise the .ts sources.
if [ -f "$ROOT/dist/build-diagram.js" ]; then B="$ROOT/dist"; X=js; else B="$ROOT"; X=ts; fi
cmd="${1:-}"; shift || true
case "$cmd" in
  build)   exec node "$B/build-diagram.$X" "$@" ;;
  init)    exec node "$B/init-project.$X" "$@" ;;
  icons)   exec node "$B/manage-icons.$X" "$@" ;;
  typecheck) exec node "$B/typecheck.$X" "$@" ;;
  show)    exec node "$B/show-diagram.$X" "$@" ;;
  md)      exec node "$B/markdown-diagram.$X" "$@" ;;
  notes)   exec node "$B/notes-diagram.$X" "$@" ;;
  diff)    exec node "$B/diff-svg.$X" "$@" ;;
  contact) exec node "$B/contact-sheet.$X" "$@" ;;
  deck)    exec node "$B/deck-diagram.$X" "$@" ;;
  pptx)    exec node "$B/pptx-diagram.$X" "$@" ;;
  check)   exec node "$B/check-diagram.$X" "$@" ;;
  lint)    exec node "$B/lint-svg.$X" "$@" ;;
  preview) exec node "$B/preview-svg.$X" "$@" ;;
  *) sed -n 2,16p "${BASH_SOURCE[0]}" | sed 's/^# \?//'; exit 2 ;;
esac
