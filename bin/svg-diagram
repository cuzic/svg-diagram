#!/usr/bin/env bash
# svg-diagram build <source.ts>... [--out file.svg]   (default out: ./svg/<name>.svg)
# svg-diagram check [--strict] [--verbose] [--drift [--svg-dir DIR] [--rebuild]] <source.ts>...
# svg-diagram diff old.svg new.svg                       (what changed, in words)
# svg-diagram contact a.svg b.svg ... --out sheet.png    (a whole set on one picture)
# svg-diagram lint  [file.svg ...] [--strict]               (default: ./svg/*.svg)
# svg-diagram preview <in.svg> <out.png> [scale]
# Diagram sources import the DSL as:  import {diagram, box, ...} from 'svg-diagram'
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# Compiled dist/ when present (installed from a package); otherwise the .ts sources.
if [ -f "$ROOT/dist/build-diagram.js" ]; then B="$ROOT/dist"; X=js; else B="$ROOT"; X=ts; fi
cmd="${1:-}"; shift || true
case "$cmd" in
  build)   exec node "$B/build-diagram.$X" "$@" ;;
  diff)    exec node "$B/diff-svg.$X" "$@" ;;
  contact) exec node "$B/contact-sheet.$X" "$@" ;;
  check)   exec node "$B/check-diagram.$X" "$@" ;;
  lint)    exec node "$B/lint-svg.$X" "$@" ;;
  preview) exec bash "$ROOT/preview_svg.sh" "$@" ;;
  *) sed -n 2,9p "${BASH_SOURCE[0]}" | sed 's/^# \?//'; exit 2 ;;
esac
