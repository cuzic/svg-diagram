+++ b/test/pick-final-two-stage.test.ts
@@ -0,0 +1,32 @@
+// ADR 0075 D3: the final pick in two stages. One `pickFinal` over main's candidates and the rows candidates together is not monotone: a rows candidate that is not chosen can still move the pick to another
+// main candidate (its fewer bends shrink the window). `pickTwoStage` picks main's figure exactly as on main and lets a rows candidate replace it only when it is strictly better (and has no more overlaps).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {pickFinal, pickTwoStage, type Judged} from '../lib/toc.ts';
+
+// scores: [AND crossings, AND side by side, crossings, pairs, bends, height]
+const J = (name: string, score: number[]): Judged & {name: string} => ({name, h: score[5]!, score, layers: [0], loose: 0, fits: undefined});
+const frame = {h: 100, layers: [0], loose: 0, fits: undefined};
+const view = (t: Judged): Judged => t;
+const first = J('first', [0, 0, 3, 0, 20, 100]), M = J('M', [0, 0, 2, 0, 12, 100]), N = J('N', [0, 0, 2, 1, 8, 100]), R = J('R', [0, 0, 2, 2, 7, 100]);
+
+test('one pickFinal over all candidates is not monotone: main alone picks M, main + R picks N (a main candidate R did not even win)', () => {
+  assert.equal((pickFinal(first, [M, N], frame, true, view) as typeof M).name, 'M');
+  assert.equal((pickFinal(first, [M, N, R], frame, true, view) as typeof M).name, 'N');
+});
+
+test('pickTwoStage: an unchosen rows candidate never changes main\'s pick', () => {
+  assert.equal((pickTwoStage(first, [M, N], [R], frame, true, view) as typeof M).name, 'M');
+  assert.equal((pickTwoStage(first, [M, N], [], frame, true, view) as typeof M).name, 'M');
+});
+
+test('pickTwoStage: a strictly better rows candidate replaces main\'s pick; a tie keeps main\'s', () => {
+  const better = J('better', [0, 0, 1, 0, 14, 100]), tie = J('tie', [...M.score]);
+  assert.equal((pickTwoStage(first, [M, N], [better], frame, true, view) as typeof M).name, 'better');
+  assert.equal((pickTwoStage(first, [M, N], [tie], frame, true, view) as typeof M).name, 'M');
+});
+
+test('pickTwoStage: a rows candidate with more overlaps than main\'s pick is not taken', () => {
+  const better = J('better', [0, 0, 1, 0, 14, 100]), ov = new Map<unknown, number>([[M, 0], [N, 0], [better, 1], [first, 0]]);
+  assert.equal((pickTwoStage(first, [M, N], [better], frame, true, view, t => ov.get(t) ?? 0) as typeof M).name, 'M');
+});
