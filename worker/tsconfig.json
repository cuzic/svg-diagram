{
  "compilerOptions": {
    "target": "es2023", "module": "esnext", "moduleResolution": "bundler", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "erasableSyntaxOnly": true, "verbatimModuleSyntax": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noUncheckedIndexedAccess": true, "noImplicitReturns": true,
    "lib": ["es2023"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
